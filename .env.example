# QuoteForge environment (§18). Copy to .env for local dev; never commit secrets.
ENVIRONMENT=dev
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://quoteforge:quoteforge@localhost:5432/quoteforge
JWT_SECRET=dev-insecure-change-me
ANTHROPIC_API_KEY=

# Transactional email (password reset). Use an external SMTP provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional
SENTRY_DSN=
